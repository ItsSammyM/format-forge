# Local Vite runs without Cloudflare Pages Functions, so keep sign-in disabled here.
VITE_AUTH_ENABLED=false

# Set VITE_AUTH_ENABLED=true in the Cloudflare Pages build environment.
# Add these as Pages runtime variables/secrets (not VITE_ variables):
# BETTER_AUTH_URL=https://your-production-domain.example
# BETTER_AUTH_SECRET=<at least 32 random characters>
# DISCORD_CLIENT_ID=<Discord OAuth2 client ID>
# DISCORD_CLIENT_SECRET=<Discord OAuth2 client secret>
